# Database Configuration (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://postgres:password@localhost:5432/myshopbd?schema=public"

# App URL & Port
APP_URL="http://localhost:3000"
PORT=3000

# Security Secrets
JWT_SECRET="myshopbd_super_secure_jwt_secret_change_in_production"
ADMIN_BOOTSTRAP_KEY="myshopbd_admin_secret_setup_key"

# Bangladesh Mobile Banking Merchant Gateways
# bKash Merchant API Credentials (https://developer.bka.sh)
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"
BKASH_APP_KEY="your_bkash_merchant_app_key"
BKASH_APP_SECRET="your_bkash_merchant_app_secret"
BKASH_USERNAME="your_bkash_merchant_username"
BKASH_PASSWORD="your_bkash_merchant_password"
BKASH_MERCHANT_NUMBER="01712345678"

# Nagad Merchant Gateway
NAGAD_MERCHANT_ID="your_nagad_merchant_id"
NAGAD_PUBLIC_KEY="your_nagad_public_key"
NAGAD_PRIVATE_KEY="your_nagad_private_key"

# SSLCOMMERZ Payment Gateway (https://developer.sslcommerz.com)
SSLCOMMERZ_STORE_ID="your_sslcz_store_id"
SSLCOMMERZ_STORE_PASSWORD="your_sslcz_store_passwd"
SSLCOMMERZ_IS_LIVE=false

# Media & Storage (AWS S3 / Cloudinary)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

